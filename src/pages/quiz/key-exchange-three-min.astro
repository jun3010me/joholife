---
// 鍵交換課題（自由モード：通信回数を節約して3人で鍵交換）：保存したJSONを提出して、修了証を発行する
import Layout from '../../layouts/Layout.astro';
import { taskById } from '../../components/quiz/key-exchange-tasks.ts';

const task = taskById('key-exchange-three-min')!;
---

<Layout title={`${task.title} - じょうほうらいふ`}>
  <div class="container mx-auto px-4 py-8">
    <div id="ke-submit-app" data-task={task.id}></div>
  </div>
</Layout>

<script is:inline src="/scripts/certificate-download.js"></script>
<script>
  import { mountKeyExchangeSubmit } from '../../components/quiz/key-exchange-submit.ts';
  mountKeyExchangeSubmit();
</script>
