            <!-- Answer Options -->
            <div style="margin-bottom: 2rem;">
              <h3 style="font-size: 1.125rem; font-weight: 600; color: var(--text-primary); margin-bottom: 1rem;">あなたの解答</h3>
              <div style="space-y: 0.75rem;">
                ${currentQuestion.type === 'text-input' ? `
