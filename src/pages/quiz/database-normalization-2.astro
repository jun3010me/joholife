---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="データベース正規化課題② - じょうほうらいふ">
  <div class="container mx-auto px-4 py-8">
    <div id="database-quiz-app" class="max-w-4xl mx-auto">
      <div class="flex items-center justify-center py-12">
        <div class="flex items-center space-x-2">
          <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-blue-500"></div>
          <span class="text-gray-600">課題を読み込み中...</span>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script is:inline src="/scripts/certificate-download.js"></script>
<script>
async function loadDatabaseQuestions() {
  return {
    id: 'database-normalization-2',
    title: 'データベース正規化課題②',
    description: '病院予約システムのデータを正規化し、完成したJSONファイルをアップロードして、正規化が正しく行われているかを判定します',
    icon: '🗄️',
    difficulty: 'hard',
    estimatedTime: 40,
    category: 'データベース',
    tags: ['データベース', '正規化', 'テーブル設計', 'シミュレータ', '複数マスタ'],
    questions: [{
      id: 'hospital-normalization',
      type: 'file-analysis',
      title: '病院予約システムデータの正規化',
      description: `**課題内容**

病院の予約管理システムのデータを第3正規形まで正規化してください。

**配布ファイル**
- <a href="/database-normalization/normalization-2.csv" download style="color: #3b82f6; text-decoration: underline;">normalization-2.csv</a>をダウンロードしてください

**正規化の手順**
1. データベース正規化シミュレータ（<a href="/database-simulator" target="_blank" style="color: #3b82f6; text-decoration: underline;">/database-simulator</a>）を開く
2. 「リセット」ボタンを押して初期状態にする
3. 「CSV読込」ボタンを押し、ダウンロードしたnormalization-2.csvを読み込む
4. 列を適切なテーブルに移動して正規化を行う
5. 完成したら「保存」ボタンでJSONファイルをダウンロード
6. このページにJSONファイルをアップロードして判定

**判定条件**
- 5つのテーブルが存在する
- 各テーブルに適切な列が配置されている
- 主キーが正しく設定されている（テーブル名は問わない）
- データの整合性が保たれている
- リレーションが適切に設定されている`,
      validation: function validateDatabase(databaseData) {
        const { tables, relations } = databaseData;

        console.log('=== データベース正規化判定開始 ===');
        console.log('テーブル数:', tables ? tables.length : 0);
        console.log('リレーション数:', relations ? relations.length : 0);

        // テーブル数の確認
        if (!tables || tables.length !== 5) {
          return { valid: false, message: `テーブル数が5つではありません（現在: ${tables ? tables.length : 0}個）` };
        }

        // 各テーブルの列名を取得
        const tableColumns = tables.map(table => ({
          name: table.name,
          columns: table.columns.map(col => col.name),
          primaryKeys: table.columns.filter(col => col.isPrimaryKey).map(col => col.name)
        }));

        console.log('テーブル構成:', JSON.stringify(tableColumns, null, 2));

        // 必要な列の定義
        const requiredColumns = {
          reservation: ['予約ID', '予約日時', '患者ID', '診療科ID', '医師ID', '診察室', '診察時間', '診察内容', '処方箋番号'],
          patient: ['患者ID', '患者名', '患者生年月日', '患者電話番号', '患者住所', '患者保険証番号'],
          department: ['診療科ID', '診療科名', '診療科フロア'],
          doctor: ['医師ID', '医師名', '医師専門分野', '医師免許番号', '診療科ID'],
          prescription: ['処方箋番号', '薬剤名', '投薬日数']
        };

        // 各テーブルタイプを識別
        let reservationTable = null;
        let patientTable = null;
        let departmentTable = null;
        let doctorTable = null;
        let prescriptionTable = null;

        for (const table of tables) {
          const columnNames = table.columns.map(col => col.name);

          // 予約トランザクションテーブルの識別
          if (columnNames.includes('予約ID') && columnNames.includes('予約日時') && columnNames.includes('診察内容')) {
            reservationTable = table;
            console.log('予約トランザクションテーブル発見:', table.name);
          }
          // 患者マスタテーブルの識別
          else if (columnNames.includes('患者ID') && columnNames.includes('患者名') && columnNames.includes('患者生年月日')) {
            patientTable = table;
            console.log('患者マスタテーブル発見:', table.name);
          }
          // 診療科マスタテーブルの識別
          else if (columnNames.includes('診療科ID') && columnNames.includes('診療科名') && columnNames.includes('診療科フロア')) {
            departmentTable = table;
            console.log('診療科マスタテーブル発見:', table.name);
          }
          // 医師マスタテーブルの識別
          else if (columnNames.includes('医師ID') && columnNames.includes('医師名') && columnNames.includes('医師専門分野')) {
            doctorTable = table;
            console.log('医師マスタテーブル発見:', table.name);
          }
          // 処方箋マスタテーブルの識別
          else if (columnNames.includes('処方箋番号') && columnNames.includes('薬剤名') && columnNames.includes('投薬日数')) {
            prescriptionTable = table;
            console.log('処方箋マスタテーブル発見:', table.name);
          }
        }

        // テーブルの存在確認
        if (!reservationTable) {
          return { valid: false, message: '予約トランザクションテーブルが見つかりません。予約ID、予約日時、診察内容を含むテーブルを作成してください。' };
        }
        if (!patientTable) {
          return { valid: false, message: '患者マスタテーブルが見つかりません。患者ID、患者名、患者生年月日を含むテーブルを作成してください。' };
        }
        if (!departmentTable) {
          return { valid: false, message: '診療科マスタテーブルが見つかりません。診療科ID、診療科名、診療科フロアを含むテーブルを作成してください。' };
        }
        if (!doctorTable) {
          return { valid: false, message: '医師マスタテーブルが見つかりません。医師ID、医師名、医師専門分野を含むテーブルを作成してください。' };
        }
        if (!prescriptionTable) {
          return { valid: false, message: '処方箋マスタテーブルが見つかりません。処方箋番号、薬剤名、投薬日数を含むテーブルを作成してください。' };
        }

        // 予約トランザクションテーブルの列構成チェック
        const reservationColumns = reservationTable.columns.map(col => col.name);
        const missingReservationCols = requiredColumns.reservation.filter(col => !reservationColumns.includes(col));
        if (missingReservationCols.length > 0) {
          return { valid: false, message: `予約トランザクションテーブルに必要な列が不足しています: ${missingReservationCols.join(', ')}` };
        }

        // 患者マスタテーブルの列構成チェック
        const patientColumns = patientTable.columns.map(col => col.name);
        const missingPatientCols = requiredColumns.patient.filter(col => !patientColumns.includes(col));
        if (missingPatientCols.length > 0) {
          return { valid: false, message: `患者マスタテーブルに必要な列が不足しています: ${missingPatientCols.join(', ')}` };
        }

        // 診療科マスタテーブルの列構成チェック
        const departmentColumns = departmentTable.columns.map(col => col.name);
        const missingDepartmentCols = requiredColumns.department.filter(col => !departmentColumns.includes(col));
        if (missingDepartmentCols.length > 0) {
          return { valid: false, message: `診療科マスタテーブルに必要な列が不足しています: ${missingDepartmentCols.join(', ')}` };
        }

        // 医師マスタテーブルの列構成チェック
        const doctorColumns = doctorTable.columns.map(col => col.name);
        const missingDoctorCols = requiredColumns.doctor.filter(col => !doctorColumns.includes(col));
        if (missingDoctorCols.length > 0) {
          return { valid: false, message: `医師マスタテーブルに必要な列が不足しています: ${missingDoctorCols.join(', ')}` };
        }

        // 処方箋マスタテーブルの列構成チェック
        const prescriptionColumns = prescriptionTable.columns.map(col => col.name);
        const missingPrescriptionCols = requiredColumns.prescription.filter(col => !prescriptionColumns.includes(col));
        if (missingPrescriptionCols.length > 0) {
          return { valid: false, message: `処方箋マスタテーブルに必要な列が不足しています: ${missingPrescriptionCols.join(', ')}` };
        }

        // 主キーの確認
        const reservationPKs = reservationTable.columns.filter(col => col.isPrimaryKey).map(col => col.name);
        if (reservationPKs.length === 0 || !reservationPKs.includes('予約ID')) {
          return { valid: false, message: '予約トランザクションテーブルの主キーが正しく設定されていません。予約IDを主キーに設定してください。' };
        }

        const patientPKs = patientTable.columns.filter(col => col.isPrimaryKey).map(col => col.name);
        if (patientPKs.length === 0 || !patientPKs.includes('患者ID')) {
          return { valid: false, message: '患者マスタテーブルの主キーが正しく設定されていません。患者IDを主キーに設定してください。' };
        }

        const departmentPKs = departmentTable.columns.filter(col => col.isPrimaryKey).map(col => col.name);
        if (departmentPKs.length === 0 || !departmentPKs.includes('診療科ID')) {
          return { valid: false, message: '診療科マスタテーブルの主キーが正しく設定されていません。診療科IDを主キーに設定してください。' };
        }

        const doctorPKs = doctorTable.columns.filter(col => col.isPrimaryKey).map(col => col.name);
        if (doctorPKs.length === 0 || !doctorPKs.includes('医師ID')) {
          return { valid: false, message: '医師マスタテーブルの主キーが正しく設定されていません。医師IDを主キーに設定してください。' };
        }

        const prescriptionPKs = prescriptionTable.columns.filter(col => col.isPrimaryKey).map(col => col.name);
        if (prescriptionPKs.length === 0 || !prescriptionPKs.includes('処方箋番号')) {
          return { valid: false, message: '処方箋マスタテーブルの主キーが正しく設定されていません。処方箋番号を主キーに設定してください。' };
        }

        // リレーションの確認（最低5つ必要）
        if (!relations || relations.length < 5) {
          return { valid: false, message: 'テーブル間のリレーションが不足しています。患者ID、診療科ID、医師ID、処方箋番号を使って適切なリレーションを設定してください。' };
        }

        // 患者IDのリレーションチェック
        const patientRelation = relations.find(rel => rel.columnName === '患者ID');
        if (!patientRelation) {
          return { valid: false, message: '患者マスタと予約トランザクション間のリレーション（患者ID）が設定されていません。' };
        }

        // 診療科IDのリレーションチェック（予約→診療科）
        const departmentToReservationRelation = relations.find(rel =>
          rel.columnName === '診療科ID' && rel.toTable === reservationTable.id
        );
        if (!departmentToReservationRelation) {
          return { valid: false, message: '診療科マスタと予約トランザクション間のリレーション（診療科ID）が設定されていません。' };
        }

        // 医師IDのリレーションチェック
        const doctorRelation = relations.find(rel =>
          rel.columnName === '医師ID' && rel.toTable === reservationTable.id
        );
        if (!doctorRelation) {
          return { valid: false, message: '医師マスタと予約トランザクション間のリレーション（医師ID）が設定されていません。' };
        }

        // 処方箋番号のリレーションチェック
        const prescriptionRelation = relations.find(rel => rel.columnName === '処方箋番号');
        if (!prescriptionRelation) {
          return { valid: false, message: '処方箋マスタと予約トランザクション間のリレーション（処方箋番号）が設定されていません。' };
        }

        // 診療科IDのリレーションチェック（診療科→医師）
        const departmentToDoctorRelation = relations.find(rel =>
          rel.columnName === '診療科ID' && rel.toTable === doctorTable.id
        );
        if (!departmentToDoctorRelation) {
          return { valid: false, message: '診療科マスタと医師マスタ間のリレーション（診療科ID）が設定されていません。' };
        }

        console.log('=== 判定結果: 合格 ===');
        return { valid: true, message: '全ての条件を満たしています！データベースが正しく第3正規形まで正規化されました。' };
      },
      explanation: `この課題では、非正規化された病院予約システムのデータを第3正規形まで正規化しました。

**正規化のポイント**

**第1正規形（1NF）**
- すべてのカラムが原子値（分割できない値）であること
- 繰り返しグループがないこと

**第2正規形（2NF）**
- 1NFを満たしていること
- 部分関数従属を排除すること
- 主キーの一部だけに従属する列がないこと

**第3正規形（3NF）**
- 2NFを満たしていること
- 推移的関数従属を排除すること
- 主キー以外のキーに従属する列がないこと

**今回の正規化**

元のデータには以下の問題がありました：
- 患者情報（患者名、生年月日、電話番号、住所、保険証番号）が予約レコードごとに重複
- 診療科情報（診療科名、フロア）が予約レコードごとに重複
- 医師情報（医師名、専門分野、免許番号）が予約レコードごとに重複
- 処方箋情報（薬剤名、投薬日数）が予約レコードごとに重複
- データの更新異常（患者の電話番号変更時に複数レコードを更新する必要）
- データの削除異常（予約履歴を削除すると患者情報も消える）
- データの挿入異常（予約がない患者や医師の情報を登録できない）

正規化のヒント：
- 予約トランザクション情報を管理するテーブル
- 患者情報を管理するマスタテーブル
- 診療科情報を管理するマスタテーブル
- 医師情報を管理するマスタテーブル
- 処方箋情報を管理するマスタテーブル

この5つのテーブルに分割することで：
- データの重複がなくなり、ストレージ効率が向上
- 更新・削除・挿入の異常が解消
- データの整合性が保証される
- 各エンティティが独立して管理できる
- 医師と診療科の関係も適切に管理できる`,
      difficulty: 'hard',
      points: 30,
      tags: ['第3正規形', 'テーブル設計', '主キー', '外部キー']
    }]
  };
}

function parseMarkdown(text) {
  if (!text) return '';

  return text
    .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
    .replace(/(?<!\*)\*(?!\*)([^*]+)\*(?!\*)/g, '<em>$1</em>')
    .replace(/`([^`]+)`/g, '<code style="background: #f3f4f6; padding: 0.125rem 0.25rem; border-radius: 0.25rem; font-family: monospace;">$1</code>')
    .replace(/<br>/g, '<br>')
    .replace(/\n/g, '<br>')
    .replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" target="_blank" rel="noopener noreferrer" style="color: var(--primary-color); text-decoration: underline;">$1</a>');
}

class DatabaseQuizSession {
  constructor() {
    this.questionSet = null;
    this.questions = [];
    this.currentQuestionIndex = 0;
    this.results = {};
    this.startTime = new Date();
    this.userName = '';
    this.showingNameInput = true;
    this.showingCertificate = false;
    this.isCompleted = false;
    this.currentUploadedFile = null;

    this.cachedIpAddress = null;
    this.sessionId = null;
    this.tryGetIPAddress();

    this.init();
  }

  async init() {
    try {
      this.questionSet = await loadDatabaseQuestions();
      if (!this.questionSet) {
        throw new Error('Question set not found');
      }

      this.questions = this.questionSet.questions;
      this.render();
    } catch (error) {
      console.error('Error loading question set:', error);
      this.renderError();
    }
  }

  render() {
    const container = document.getElementById('database-quiz-app');
    if (!container) return;

    if (this.showingNameInput) {
      this.renderNameInput();
      return;
    }

    if (this.showingCertificate) {
      this.renderCertificate();
      return;
    }

    if (this.isCompleted) {
      this.renderResult();
      return;
    }

    const currentQuestion = this.questions[this.currentQuestionIndex];
    const timeElapsed = Math.floor((new Date() - this.startTime) / 1000);
    const completedQuestions = Object.keys(this.results).length;
    const correctAnswers = Object.values(this.results).filter(result => result.isCorrect).length;

    container.innerHTML = `
      <div class="space-y-6">
        <!-- Progress Bar -->
        <div class="card" style="margin-bottom: 2rem;">
          <div style="margin-bottom: 1.5rem;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
              <span style="font-size: 0.875rem; font-weight: 500; color: var(--text-primary);">進捗</span>
              <span style="font-size: 0.875rem; color: var(--text-secondary);">
                ${this.currentQuestionIndex + 1} / ${this.questions.length}
              </span>
            </div>
            <div style="width: 100%; background: var(--border); border-radius: var(--radius-md); height: 8px;">
              <div
                style="background: linear-gradient(90deg, var(--primary-color), var(--secondary-color)); height: 8px; border-radius: var(--radius-md); transition: all 0.3s ease; width: ${((this.currentQuestionIndex + 1) / this.questions.length) * 100}%;"
              ></div>
            </div>
          </div>

          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); gap: 1rem; text-align: center;">
            <div style="background: var(--surface); border-radius: var(--radius-md); padding: 1rem;">
              <div style="font-size: 1.5rem; font-weight: 700; color: var(--primary-color);">${completedQuestions}</div>
              <div style="font-size: 0.75rem; color: var(--primary-color); font-weight: 500;">提出済み</div>
            </div>
            <div style="background: var(--surface); border-radius: var(--radius-md); padding: 1rem;">
              <div style="font-size: 1.5rem; font-weight: 700; color: var(--secondary-color);">${correctAnswers}</div>
              <div style="font-size: 0.75rem; color: var(--secondary-color); font-weight: 500;">合格</div>
            </div>
            <div style="background: var(--surface); border-radius: var(--radius-md); padding: 1rem;">
              <div style="font-size: 1.5rem; font-weight: 700; color: var(--accent-color);">
                ${completedQuestions > 0 ? Math.round((correctAnswers / completedQuestions) * 100) : 0}%
              </div>
              <div style="font-size: 0.75rem; color: var(--accent-color); font-weight: 500;">合格率</div>
            </div>
            <div style="background: var(--surface); border-radius: var(--radius-md); padding: 1rem;">
              <div style="font-size: 1.5rem; font-weight: 700; color: var(--primary-color);">
                ${Math.floor(timeElapsed / 60)}:${(timeElapsed % 60).toString().padStart(2, '0')}
              </div>
              <div style="font-size: 0.75rem; color: var(--primary-color); font-weight: 500;">経過時間</div>
            </div>
          </div>
        </div>

        <!-- Question Card -->
        <div class="card" style="overflow: hidden; margin-bottom: 2rem;">
          <!-- Header -->
          <div style="background: linear-gradient(135deg, var(--primary-color), var(--secondary-color)); padding: 2rem; color: white;">
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1rem;">
              <div style="display: flex; align-items: center; gap: 0.75rem;">
                <span style="font-size: 1.5rem; font-weight: 700;">課題 ${this.currentQuestionIndex + 1}</span>
                <span style="opacity: 0.8;">/ ${this.questions.length}</span>
              </div>
              <div style="display: flex; align-items: center; gap: 0.5rem;">
                <span style="background: rgba(255,255,255,0.2); padding: 0.25rem 0.75rem; border-radius: var(--radius-md); font-size: 0.875rem; font-weight: 500;">
                  ${this.getDifficultyText(currentQuestion.difficulty)}
                </span>
                <span style="background: rgba(255,255,255,0.2); padding: 0.25rem 0.75rem; border-radius: var(--radius-md); font-size: 0.875rem; font-weight: 500;">
                  ${currentQuestion.points}点
                </span>
              </div>
            </div>
          </div>

          <!-- Question Content -->
          <div style="padding: 2rem;">
            <h3 style="font-size: 1.25rem; font-weight: 600; color: var(--text-primary); margin-bottom: 1rem;">
              ${parseMarkdown(currentQuestion.title)}
            </h3>

            <div style="color: var(--text-secondary); margin-bottom: 2rem; line-height: 1.6;">
              ${parseMarkdown(currentQuestion.description)}
            </div>

            <!-- File Upload Area -->
            <div style="margin-bottom: 2rem;">
              <div
                id="file-drop-zone"
                style="
                  border: 2px dashed var(--border);
                  border-radius: var(--radius-md);
                  padding: 2rem;
                  text-align: center;
                  background: var(--surface);
                  transition: all 0.3s ease;
                  cursor: pointer;
                "
                ondragover="event.preventDefault(); this.style.borderColor = 'var(--primary-color)'; this.style.background = 'var(--primary-bg-light)';"
                ondragleave="this.style.borderColor = 'var(--border)'; this.style.background = 'var(--surface)';"
