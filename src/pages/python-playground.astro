        // CodeMirrorが実際に必要としている「コンテンツ本来の高さ」を取得する。
        //
        // codeEditor.getScrollInfo().height は .CodeMirror-scroll 要素の
        // scrollHeight を返すが、このサイトでは .CodeMirror-scroll に
        // min-height: 100% !important を指定している（コード量が少ない時に
        // エディタの箱いっぱいに黒背景を広げるための指定）。そのため、
        // 先に #code-editor-container の高さを大きくしてしまっていると、
        // その「今の箱の高さ」が min-height 経由で scrollHeight にも
        // そのまま反映されてしまい、「測った高さでまた同じ高さに戻す」という
        // 循環参照になって、一度大きくなった高さが二度と縮まらなくなる不具合が
        // あった（実際に発生：中身が1行だけなのに巨大な高さのまま固定される）。
        //
        // .CodeMirror-sizer はCodeMirrorが内部で実際の行の高さの合計に基づいて
        // 自分でサイズを設定している要素で、.CodeMirror-scroll のCSS指定
        // （min-height:100%等）の影響を受けない。こちらを使うことで、
        // 常に「本当にコード本文が必要としている高さ」だけを取得できる。
        function getCodeMirrorContentHeight() {
            if (!codeEditor) return 0;
            const sizer = codeEditor.getWrapperElement().querySelector('.CodeMirror-sizer');
            if (sizer) return sizer.getBoundingClientRect().height;
            return codeEditor.getScrollInfo().height;
        }

        // コードの内容（改行・折り返しによる行数）に応じて、#code-editor-container の
        // 高さを実際に必要な分だけ広げる。ウィンドウ幅が変わって折り返しの行数が
        // 変わった場合の再計算にも使うため、リサイズ時にも安全に呼べる
        // （.playground-content 自体の高さには一切手を出さない）。
        function updateCodeContainerMinHeight() {
            if (!codeEditor) return 0;
            const container = document.getElementById('code-editor-container');
            if (!container) return 0;
            const contentHeight = getCodeMirrorContentHeight();
            const neededContainerHeight = Math.max(CODE_EDITOR_MIN_HEIGHT, Math.ceil(contentHeight));
            container.style.minHeight = `${neededContainerHeight}px`;
            return neededContainerHeight;
        }

        // コードの内容が増えて #code-editor-container の高さが伸びる時、初回表示時の
        // 調整（fitCodeEditorToViewportOnce）で .playground-content に明示的な高さを
        // 与えている場合は、その高さも合わせて広げる（縮めることはしない）。
        //
        // プロジェクター投影時に「コードを増やしてわざと縦幅を伸ばし、画面下の
        // 余計な部分を隠す」という使い方を想定しているため、最大値は設けず、
        // 必要な分だけどこまでも伸ばす。#code-editor-container の高さが伸びると、
        // CSS Grid の align-items:stretch により右側（実行結果・変数トレース）も
        // 自動的に同じ高さまで伸びる。
        //
        // 重要: これはコードの内容が実際に変わった時（入力・貼り付け・フォント
        // サイズ変更）にだけ呼び出すこと。ウィンドウのリサイズやブラウザの拡大率
        // 変更のたびに呼ぶと、「伸びるだけで縮まない」処理のため、リサイズの
        // たびに高さが伸びっぱなしになってしまう不具合になる
        // （実際に発生した不具合: ブラウザの表示倍率を変えるたびに高さが伸び、
        // 元の倍率に戻しても縮まなくなった）。リサイズ時は
        // updateCodeContainerMinHeight() だけを呼ぶこと。
        function growCodeEditorToFitContent() {
            const neededContainerHeight = updateCodeContainerMinHeight();
            if (!codeEditor || !neededContainerHeight) return;

            const container = document.getElementById('code-editor-container');
            const playgroundContent = document.querySelector('.playground-content');
            const codeSection = document.querySelector('.code-section');
            if (!container || !playgroundContent || !codeSection || !playgroundContent.style.height) return;

            // ツールバー・フォントサイズスライダーの高さ（chrome）は、
            // #code-editor-container.top から .code-section.top までの距離として
            // 求める。.code-section 自体がまだ .playground-content の明示的な高さで
            // 縮められている状態だと、container側のrectもその制約内に収まって
            // しまうため、両者の高さの差ではなく上端位置の差を使うことで、
            // 現在の制約に左右されない正しいchrome高さを得る。
            const currentHeight = parseFloat(playgroundContent.style.height) || 0;
            const codeChrome = container.getBoundingClientRect().top - codeSection.getBoundingClientRect().top;
            const neededHeight = Math.ceil(neededContainerHeight + codeChrome);
            if (neededHeight > currentHeight) {
                playgroundContent.style.height = `${neededHeight}px`;
