        // コード・実行結果・変数トレースの下端が、ブラウザの表示領域（ビューポート）の
        // 下端にちょうど合うように高さを調整する。ページを開いた直後・リロード直後は
        // もちろん、ブラウザの表示倍率やウィンドウサイズが変わった時にも呼び出す
        // （resize イベント経由）。デバイスの表示倍率をショートカットキーで変えられない
        // 環境（iPadなど）でも、常に画面いっぱいに使えるようにするための調整。
        //
        // 伸びる方向にも縮む方向にも動く点が growCodeEditorToFitContent()（伸びる方向にしか
        // 動かない、コードの内容が増えた時専用の処理）との大きな違い。resize のたびに
        // こちらを呼んでも、内容が必要とする高さ（codeFloor）を下回ることはない
        // （Math.max(availableHeight, codeFloor + codeChrome) で計算しているため）ので、
        // 「伸びっぱなしで縮まない」不具合には繋がらない。
        //
        // モバイル幅（画面が上下積みレイアウトになる）ではコードエディタと右側の高さが
        // 連動しないため、この調整は行わない。
        function fitCodeEditorToViewportOnce() {
            if (window.matchMedia('(max-width: 768px)').matches) return;

            const playgroundContent = document.querySelector('.playground-content');
            const codeSection = document.querySelector('.code-section');
            const codeContainer = document.getElementById('code-editor-container');
            if (!playgroundContent || !codeSection || !codeContainer) return;

            const rect = playgroundContent.getBoundingClientRect();
            // window.innerHeight ではなく document.documentElement.clientHeight を使う。
            // タブレット端末のブラウザ（Edge on Surfaceなど）はアドレスバーなどの
            // 表示状態によって window.innerHeight が変動しやすく、clientHeight の
            // 方が実際にレイアウトへ反映される表示領域として安定している。
            const viewportHeight = document.documentElement.clientHeight;
            // rect.top はビューポート基準（現在のスクロール位置に依存）の値。
            // ページがスクロールされた状態でこの関数が呼ばれると、rect.top が
            // 大きくマイナスになり、availableHeight が実際よりずっと大きく計算
            // されてしまう（ブラウザがリロード時にスクロール位置を復元する場合、
            // 一度おかしな高さになるとリロードのたびに悪化していくことがあった）。
            // window.scrollY を足して「ページ先頭から見た時の位置」に変換することで、
            // 現在のスクロール位置に左右されない計算にする。
            const topFromPageStart = rect.top + window.scrollY;
            const availableHeight = viewportHeight - topFromPageStart - 8;
            if (availableHeight <= 0) return;

            // コードの内容がこの高さより多く必要な場合は内容量を優先する
            // （改行で増やした分を初回調整で勝手に縮めたりはしない）。
            const codeContentHeight = getCodeMirrorContentHeight();
            const codeFloor = Math.max(CODE_EDITOR_MIN_HEIGHT, codeContentHeight);
            // codeSection全体からcodeContainerの高さを引くのではなく、上端の位置の
            // 差分（ツールバー・フォントサイズスライダーの高さ）を使う。すでに何らかの
            // 制約でcodeContainerの高さが縮められている状態で呼ばれても、この方法なら
            // 影響を受けず正しいchrome高さが求まる。
            const codeChrome = codeContainer.getBoundingClientRect().top - codeSection.getBoundingClientRect().top;

            const targetHeight = Math.max(availableHeight, codeFloor + codeChrome);

            // .playground-content 自体に明示的な高さを与えることで、CSS Gridの
            // 1行ぶんの高さをその値に固定する。align-items:stretch と、
            // .code-section／.right-column 以下の各要素にすでに指定している
            // flex-grow・flex-shrink・min-height:0 の組み合わせにより、
            // コード側・実行結果・変数トレースの全てが、伸ばす方向にも
            // 縮める方向にも、この高さに合わせて追従する。
            playgroundContent.style.height = `${Math.floor(targetHeight)}px`;
            playgroundContent.style.gridTemplateRows = '1fr';
        }

        function applyTraceFontSize(size) {
            const root = document.querySelector('.python-playground');
            if (root) root.style.setProperty('--pp-trace-font-size', `${size}px`);
            const label = document.getElementById('trace-font-size-value');
            if (label) label.textContent = `${size}px`;
        }

        function applyOutputFontSize(size) {
            const root = document.querySelector('.python-playground');
            if (root) root.style.setProperty('--pp-output-font-size', `${size}px`);
            const label = document.getElementById('output-font-size-value');
            if (label) label.textContent = `${size}px`;
        }

        // コード／実行結果／変数トレースの各パネルを表示・非表示にした結果を踏まえて、
        // 全体のグリッドレイアウトを整える。片側が空になったら、もう片側を
        // 画面いっぱいに広げる（投影授業でコード（または結果）だけを見せたい場面を想定）。
        function updatePlaygroundGridLayout() {
            const codeSection = document.querySelector('.code-section');
            const outputSection = document.querySelector('.output-section');
            const traceSection = document.querySelector('.trace-section');
            const rightColumn = document.querySelector('.right-column');
            const playgroundContent = document.querySelector('.playground-content');
            if (!codeSection || !outputSection || !traceSection || !rightColumn || !playgroundContent) return;

            const codeVisible = !codeSection.classList.contains('panel-hidden');
            const outputVisible = !outputSection.classList.contains('panel-hidden');
            const traceVisible = !traceSection.classList.contains('panel-hidden');
            const rightHasContent = outputVisible || traceVisible;

            rightColumn.classList.toggle('panel-hidden', !rightHasContent);
            playgroundContent.classList.toggle('code-hidden', !codeVisible && rightHasContent);
            playgroundContent.classList.toggle('right-hidden', codeVisible && !rightHasContent);

            // 実行結果・変数トレースの各エリアは、常に flex-grow で自分のセクション内の
            // 余った縦幅を埋めるようCSS側で処理する（.output-section, .trace-section,
            // #output-area, .trace-table-container 参照）。表示パネルが1つだけの時も
            // 2つとも表示している時も、同じ仕組みでコードエディタの高さに追従する。

            applyColumnRatio();
        }

        // コードエディタ（左）と実行結果・変数トレース（右）の幅の比率を適用する。
        // 片側の列自体が消えている（code-hidden/right-hidden）時や、画面が狭く
        // 上下に積み重なるレイアウト（@media (max-width: 768px)）になっている時は
        // 単一カラムになるため、比率の指定はしない（CSS側の
        // grid-template-columns: 1fr に任せる。ここでinline style指定を残すと、
        // 詳細度の関係でモバイル用の1カラム表示を上書きしてしまう）。
        function applyColumnRatio() {
            const playgroundContent = document.querySelector('.playground-content');
            if (!playgroundContent) return;

            const isMobile = window.matchMedia('(max-width: 768px)').matches;
            const isSingleColumn = playgroundContent.classList.contains('code-hidden') ||
                playgroundContent.classList.contains('right-hidden') ||
                isMobile;

            // モバイル幅（画面が上下積みレイアウトになる）の時だけ、
            // fitCodeEditorToViewportOnce() が付与した明示的な高さも解除する。
            // モバイルでは1カラムの意味がデスクトップと異なり（横並びではなく
            // 縦積み）、高さの指定を残すとレイアウトが崩れる（コード側の高さが
            // 0になる等）ことがあったため。
            //
            // 一方、デスクトップ幅での code-hidden／right-hidden（表示パネルを
            // チェックボックスで減らして1カラムになっている場合）は、単に横に
            // 並ぶ列が1つになるだけで縦の積み方は変わらないため、高さの指定を
            // 消す必要はない。ここで一緒に消してしまうと、「実行結果」「変数
            // トレース」を両方非表示にした直後にビューポートへの高さ合わせが
            // 効かなくなる不具合になる（実際に発生した不具合）。
            if (isMobile) {
                playgroundContent.style.height = '';
                playgroundContent.style.gridTemplateRows = '';
            }

            if (isSingleColumn) {
                playgroundContent.style.gridTemplateColumns = '';
                return;
            }

            const ratioMap = { '1:1': [1, 1], '1:2': [1, 2], '2:1': [2, 1] };
            const [leftFr, rightFr] = ratioMap[columnRatio] || ratioMap['1:1'];
            playgroundContent.style.gridTemplateColumns = `minmax(0, ${leftFr}fr) minmax(0, ${rightFr}fr)`;
        }

        // 幅の比率を「1:1 → 1:2 → 2:1 → 1:1 ...」の順で切り替える。
        function cycleColumnRatio() {
            const currentIndex = COLUMN_RATIOS.indexOf(columnRatio);
            columnRatio = COLUMN_RATIOS[(currentIndex + 1) % COLUMN_RATIOS.length];
            const label = document.getElementById('column-ratio-label');
            if (label) label.textContent = columnRatio;
            applyColumnRatio();
            try { localStorage.setItem('pythonPlaygroundColumnRatio', columnRatio); } catch (err) {}
        }

        // コードエリアの表示・非表示を切り替える。
        // 投影授業で「コードは隠して変数の動きだけ見せたい」場面を想定している。
        function applyCodeVisibility(visible) {
            const codeSection = document.querySelector('.code-section');
            if (codeSection) codeSection.classList.toggle('panel-hidden', !visible);
            updatePlaygroundGridLayout();

            if (visible && codeEditor) {
                // 非表示の間はCodeMirrorがサイズを正しく計算できないため、
                // 再表示時にレイアウトを計算し直す。
                setTimeout(() => codeEditor.refresh(), 0);
            }
        }

        // 実行結果エリアの表示・非表示を切り替える。
        function applyOutputVisibility(visible) {
            const outputSection = document.querySelector('.output-section');
            if (outputSection) outputSection.classList.toggle('panel-hidden', !visible);
            updatePlaygroundGridLayout();
        }

        // 変数トレースエリアの表示・非表示を切り替える。
        function applyTraceVisibility(visible) {
            const traceSection = document.querySelector('.trace-section');
            if (traceSection) traceSection.classList.toggle('panel-hidden', !visible);
            updatePlaygroundGridLayout();
        }

        // 表示設定（フォントサイズ・向き・コード表示/非表示）の復元
        function restoreSettings() {
            try {
                const codeFontSize = localStorage.getItem('pythonPlaygroundCodeFontSize');
                const codeFontSizeInput = document.getElementById('code-font-size');
                if (codeFontSize && codeFontSizeInput) {
                    codeFontSizeInput.value = codeFontSize;
                }
                applyCodeFontSize(codeFontSizeInput ? codeFontSizeInput.value : 16);

                const traceFontSize = localStorage.getItem('pythonPlaygroundTraceFontSize');
                const traceFontSizeInput = document.getElementById('trace-font-size');
                if (traceFontSize && traceFontSizeInput) {
                    traceFontSizeInput.value = traceFontSize;
                }
                applyTraceFontSize(traceFontSizeInput ? traceFontSizeInput.value : 14);

                const outputFontSize = localStorage.getItem('pythonPlaygroundOutputFontSize');
                const outputFontSizeInput = document.getElementById('output-font-size');
                if (outputFontSize && outputFontSizeInput) {
                    outputFontSizeInput.value = outputFontSize;
                }
                applyOutputFontSize(outputFontSizeInput ? outputFontSizeInput.value : 14);

                const orientation = localStorage.getItem('pythonPlaygroundTraceOrientation');
                if (orientation === 'stepsAsRows') {
                    traceOrientation = 'stepsAsRows';
                    const toggle = document.getElementById('orientation-toggle');
                    if (toggle) toggle.checked = true;
                }

                const savedColumnRatio = localStorage.getItem('pythonPlaygroundColumnRatio');
                if (savedColumnRatio && COLUMN_RATIOS.includes(savedColumnRatio)) {
                    columnRatio = savedColumnRatio;
                    const ratioLabel = document.getElementById('column-ratio-label');
                    if (ratioLabel) ratioLabel.textContent = columnRatio;
                }

                const codeVisible = localStorage.getItem('pythonPlaygroundCodeVisible');
                const codeVisibilityToggle = document.getElementById('code-visibility-toggle');
                const isCodeVisible = codeVisible !== 'false'; // 既定は表示（true）
                if (codeVisibilityToggle) codeVisibilityToggle.checked = isCodeVisible;
                applyCodeVisibility(isCodeVisible);

                const outputVisible = localStorage.getItem('pythonPlaygroundOutputVisible');
                const outputVisibilityToggle = document.getElementById('output-visibility-toggle');
                const isOutputVisible = outputVisible !== 'false'; // 既定は表示（true）
                if (outputVisibilityToggle) outputVisibilityToggle.checked = isOutputVisible;
                applyOutputVisibility(isOutputVisible);

                const traceVisible = localStorage.getItem('pythonPlaygroundTraceVisible');
                const traceVisibilityToggle = document.getElementById('trace-visibility-toggle');
                const isTraceVisible = traceVisible !== 'false'; // 既定は表示（true）
                if (traceVisibilityToggle) traceVisibilityToggle.checked = isTraceVisible;
                applyTraceVisibility(isTraceVisible);
            } catch (e) {
                console.error('設定の復元に失敗しました:', e);
            }
        }

        // ドラッグ&ドロップ機能
        function setupDragAndDrop() {
            const editorContainer = document.getElementById('code-editor-container');

            editorContainer.addEventListener('dragover', (e) => {
                e.preventDefault();
                e.stopPropagation();
                editorContainer.style.border = '3px dashed #3b82f6';
                editorContainer.style.background = 'rgba(59, 130, 246, 0.05)';
            });

            editorContainer.addEventListener('dragleave', (e) => {
                e.preventDefault();
                e.stopPropagation();
                editorContainer.style.border = '2px solid #e2e8f0';
                editorContainer.style.background = '';
            });

            editorContainer.addEventListener('drop', (e) => {
                e.preventDefault();
                e.stopPropagation();
                editorContainer.style.border = '2px solid #e2e8f0';
                editorContainer.style.background = '';

                const files = e.dataTransfer.files;
                if (files.length === 0) return;

                const file = files[0];
                if (!file.name.endsWith('.py')) {
                    alert('.pyファイルをドロップしてください');
                    return;
                }

                const reader = new FileReader();
                reader.onload = function(event) {
                    if (codeEditor) {
                        codeEditor.setValue(event.target.result);
                    }
                };
                reader.readAsText(file);
            });
        }

        // イベントリスナーの設定
        document.addEventListener('DOMContentLoaded', async () => {
            console.log('DOM loaded, starting CodeMirror and Pyodide initialization...');

            // CodeMirrorエディタを初期化
            await initCodeEditor();

            // 表示設定・自動保存されたコードを復元
            restoreSettings();
            restoreAutosavedCode();
            renderTraceTable();
            updateStepIndicator();

            // 表示直後に、コード・実行結果・変数トレースの下端をブラウザの表示領域の
            // 下端に合わせる（レイアウトが落ち着いてから計測するため少し遅らせて実行）。
            // ブラウザの表示倍率変更やウィンドウサイズ変更でも表示領域の大きさは
            // 変わるため、この調整自体は resize のたびに実行し続ける（下記の
            // window.addEventListener('resize', ...) 参照）。「初回だけ」なのは
            // コードの内容量に応じた自動伸長（growCodeEditorToFitContent）の方で、
            // そちらは内容が実際に変わった時だけ伸びる方向にのみ動く。
            setTimeout(() => {
                fitCodeEditorToViewportOnce();
            }, 150);

            // Pyodideを読み込み
            loadPyodide().catch(error => {
                console.error('Failed to load Pyodide:', error);
                const statusElement = document.getElementById('python-status');
                const outputArea = document.getElementById('output-area');
                statusElement.textContent = '❌ 読み込み失敗';
                outputArea.innerHTML = `<div class="error">Pythonエンジンの読み込みに失敗しました。<br>ネットワーク接続を確認してページを再読み込みしてください。<br>詳細: ${error.message}</div>`;
            });

            // 幅の比率・ビューポートへの高さ合わせは、CodeMirrorの読み込みに失敗した
            // 場合（フォールバックのtextareaになった場合）でも、画面幅・表示倍率が
            // 変わった時に正しく機能してほしいため、CodeMirror初期化の成否に関係なく
            // 常にリサイズを監視する。
            //
            // ウィンドウサイズを一気に大きく変えた時（ゆっくりドラッグではなく、
            // スナップ機能や最大化ボタンなどで瞬時に変わった時）に追従しなくなる
            // 不具合があったため、以下の2点を修正している。
            // 1. 直前のタイマーを確実に破棄してから予約し直す（デバウンス）。
            //    デバウンスせずに resize のたびに setTimeout を積み重ねると、
            //    短時間に複数のタイマーが重なって実行され、その実行順序によっては
            //    「CodeMirrorのrefresh()より先にfitCodeEditorToViewportOnce()が
            //    走ってしまい、幅変更前の折り返し行数のまま高さを計算してしまう」
            //    といった競合が起こり得る。
            // 2. 各処理を必ず決まった順番（refresh → 高さ再計算 → ビューポートへの
            //    高さ合わせ → 幅の比率）で呼ぶことで、その競合を根本的になくす。
            let resizeDebounceTimer = null;
            window.addEventListener('resize', () => {
                clearTimeout(resizeDebounceTimer);
                resizeDebounceTimer = setTimeout(() => {
                    if (codeEditor) {
                        codeEditor.refresh();
                    }
                    updateCodeContainerMinHeight();
                    fitCodeEditorToViewportOnce();
                    applyColumnRatio();
                }, 100);
            });

            // ボタンイベント
            document.getElementById('run-btn').addEventListener('click', runCode);
            document.getElementById('clear-btn').addEventListener('click', clearCode);
            document.getElementById('example-btn').addEventListener('click', insertSampleCode);
            document.getElementById('save-btn').addEventListener('click', saveCode);
            document.getElementById('load-btn').addEventListener('click', loadCode);
            document.getElementById('file-input').addEventListener('change', handleFileSelect);

            // フォントサイズ
            document.getElementById('code-font-size').addEventListener('input', (e) => {
                applyCodeFontSize(e.target.value);
                try { localStorage.setItem('pythonPlaygroundCodeFontSize', e.target.value); } catch (err) {}
            });
            document.getElementById('trace-font-size').addEventListener('input', (e) => {
                applyTraceFontSize(e.target.value);
                try { localStorage.setItem('pythonPlaygroundTraceFontSize', e.target.value); } catch (err) {}
            });
            document.getElementById('output-font-size').addEventListener('input', (e) => {
                applyOutputFontSize(e.target.value);
                try { localStorage.setItem('pythonPlaygroundOutputFontSize', e.target.value); } catch (err) {}
            });

            // コード／実行結果／変数トレース各パネルの表示・非表示
            document.getElementById('code-visibility-toggle').addEventListener('change', (e) => {
                applyCodeVisibility(e.target.checked);
                try { localStorage.setItem('pythonPlaygroundCodeVisible', String(e.target.checked)); } catch (err) {}
            });
            document.getElementById('output-visibility-toggle').addEventListener('change', (e) => {
                applyOutputVisibility(e.target.checked);
                try { localStorage.setItem('pythonPlaygroundOutputVisible', String(e.target.checked)); } catch (err) {}
            });
            document.getElementById('trace-visibility-toggle').addEventListener('change', (e) => {
                applyTraceVisibility(e.target.checked);
                try { localStorage.setItem('pythonPlaygroundTraceVisible', String(e.target.checked)); } catch (err) {}
            });

            // コードエディタと右側の幅の比率を切り替え
            document.getElementById('column-ratio-toggle').addEventListener('click', () => {
                cycleColumnRatio();
            });

            // 変数トレース：向き切替
            document.getElementById('orientation-toggle').addEventListener('change', (e) => {
                traceOrientation = e.target.checked ? 'stepsAsRows' : 'varsAsRows';
                try { localStorage.setItem('pythonPlaygroundTraceOrientation', traceOrientation); } catch (err) {}
                renderTraceTable();
                scrollActiveStepIntoView();
            });

            // 変数トレース：ステップ移動コントロール
            document.getElementById('trace-first-btn').addEventListener('click', () => {
                goToStep(0);
            });
            document.getElementById('trace-prev-btn').addEventListener('click', () => {
                goToStep(activeStepIndex - 1);
            });
            document.getElementById('trace-next-btn').addEventListener('click', () => {
                goToStep(activeStepIndex + 1);
            });
            document.getElementById('trace-last-btn').addEventListener('click', () => {
                goToStep(traceSteps.length - 1);
            });

            // キーボードの上下左右キーでも1ステップずつ移動できるようにする。
            // 行と列を入れ替えて縦方向にスクロールする表示のときは、上下キーが
            // 表のスクロールに奪われてしまうため、左右キーと同じ「前・次のステップへ
            // 移動」の動きを上下キーにも割り当て、既定のスクロール動作は止める。
            // ただし、コードエディタや他の入力欄にフォーカスがある間は
            // 通常のカーソル移動を優先し、ステップ操作は行わない。
            document.addEventListener('keydown', (e) => {
                const isPrevKey = e.key === 'ArrowLeft' || e.key === 'ArrowUp';
                const isNextKey = e.key === 'ArrowRight' || e.key === 'ArrowDown';
                if (!isPrevKey && !isNextKey) return;
                if (traceSteps.length === 0) return;

                const active = document.activeElement;
                // チェックボックス（表示/非表示の切り替えや向き切り替え）は矢印キーで
                // 何も操作しないため、フォーカスが残っていてもステップ移動を優先する。
                const isTypingContext = (
                    (codeEditor && codeEditor.hasFocus()) ||
                    (active && (
                        active.tagName === 'TEXTAREA' ||
                        active.tagName === 'SELECT' ||
                        active.isContentEditable ||
                        (active.tagName === 'INPUT' && active.type !== 'checkbox')
                    ))
                );
                if (isTypingContext) return;

                e.preventDefault();
                if (isPrevKey) {
                    goToStep(activeStepIndex - 1);
                } else {
                    goToStep(activeStepIndex + 1);
                }
            });

            // ドラッグ&ドロップ機能を有効化
            setupDragAndDrop();
        });
    </script>

    <style is:global>
        /* このページはプロジェクター投影での全画面表示を想定しているため、
           サイト共通レイアウト（Layout.astro の .main-content）の余白を
           このページだけ狭める。この <style is:global> の効果は、Astroの
           ビルド単位（このページの出力）にのみ及び、他のページには影響しない。 */
        .main-content {
            max-width: none;
            padding: 12px 10px;
        }

        .python-playground {
            max-width: none;
            margin: 0;
            padding: 0 10px 20px;
            --pp-code-font-size: 16px;
            --pp-trace-font-size: 14px;
            --pp-output-font-size: 14px;
        }

        .playground-header {
            text-align: center;
            margin-bottom: 8px;
        }

        .visibility-toggles {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 10px;
        }

        .code-visibility-toggle {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 14px;
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 999px;
            font-size: 14px;
            font-weight: 600;
            color: #334155;
            cursor: pointer;
            user-select: none;
        }

        .code-visibility-toggle input[type="checkbox"] {
            cursor: pointer;
            width: 16px;
            height: 16px;
        }

        .code-visibility-toggle:hover {
            border-color: #2563eb;
            color: #2563eb;
        }

        /* 幅の比率切り替えボタンは <button> なので、チェックボックス版の
           見た目（丸型ピル）に合わせつつ、ブラウザ既定のボタン装飾を消す。 */
        .ratio-toggle {
            font-family: inherit;
            background: #f8fafc;
        }

        .playground-content {
            display: grid;
            /* minmax(0, 1fr) にすることで、中の表やコードがどれだけ幅を必要としても
               左右のカラム比率が常に50:50に保たれるようにする（グリッドの「はみ出し」対策） */
            grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
            gap: 20px;
            margin-bottom: 30px;
            /* stretch（既定値）にすることで、右側（実行結果＋変数トレース）の高さに
               コードエディタ側の高さを揃える。 */
            align-items: stretch;
        }

        /* 「コードを表示」チェックを外した時：コードエディタの列ごと消して、
           右側（実行結果・変数トレース）を画面いっぱいに広げる。 */
        .playground-content.code-hidden {
            grid-template-columns: 1fr;
        }

        /* 逆に「実行結果」「変数トレース」を両方とも非表示にした時：
           右側の列ごと消して、コードエディタを画面いっぱいに広げる。 */
        .playground-content.right-hidden {
            grid-template-columns: 1fr;
        }

        /* 表示/非表示チェックボックスで各パネルを隠すための共通クラス。
           .code-section 等に display:flex を指定しているため、HTMLの
           hidden属性（UA既定スタイルはauthor CSSに優先度で負ける）だけでは
           確実に隠せない。!importantで明示的に上書きする。 */
        .panel-hidden {
            display: none !important;
        }

        .code-section {
            min-width: 0;
            min-height: 0;
            display: flex;
            flex-direction: column;
        }

        .right-column {
            display: flex;
            flex-direction: column;
            gap: 20px;
            min-width: 0;
            min-height: 0;
        }

        .section-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 15px;
            padding: 10px 15px;
            background: #f8fafc;
            border-radius: 8px;
            border-left: 4px solid #2563eb;
            flex-wrap: wrap;
            gap: 10px;
        }

        .section-header h3 {
            margin: 0;
            color: #1e293b;
            font-size: clamp(1rem, 2.5vw, 1.25rem);
            white-space: nowrap;
        }

        .controls {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
            align-items: center;
        }

        .status {
            font-size: 14px;
            color: #64748b;
            display: flex;
            flex-direction: column;
            gap: 8px;
            align-items: flex-end;
        }

        .error-lang-toggle {
            display: flex;
            align-items: center;
            gap: 6px;
            cursor: pointer;
            font-size: 13px;
            color: #475569;
            user-select: none;
        }

        .error-lang-toggle input[type="checkbox"] {
            cursor: pointer;
            width: 16px;
            height: 16px;
        }

        .error-lang-toggle span {
            white-space: nowrap;
        }

        .error-lang-toggle:hover {
            color: #1e293b;
        }

        .font-size-control {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 13px;
            color: #475569;
            margin-bottom: 10px;
            flex-wrap: wrap;
        }

        .font-size-control label {
            white-space: nowrap;
        }

        .font-size-control input[type="range"] {
            flex: 1;
            min-width: 100px;
            max-width: 220px;
            cursor: pointer;
        }

        .font-size-value {
            min-width: 42px;
            text-align: right;
            font-weight: 600;
            color: #1e293b;
        }

        #code-editor-container {
            width: 100%;
            /* 固定の高さではなく、code-section内の残り空間いっぱいに広がるようにする
               （.playground-content の align-items: stretch と組み合わせて、右側の
               実行結果＋変数トレースと同じ高さになる）。
               min-height はJS側の CODE_EDITOR_MIN_HEIGHT と合わせてある
               （CodeMirror読み込み前・失敗時のフォールバック値）。 */
            flex: 1;
            min-height: 60px;
            border: 2px solid #e2e8f0;
            border-radius: 8px;
            overflow: hidden;
            transition: border-color 0.3s;
            display: flex;
            flex-direction: column;
        }

        /* CodeMirrorのマウント先。#code-editor-container(flexコンテナ)の
           直接の子として、残り空間いっぱいに広がる必要がある。これが無いと
           中の .CodeMirror に height:100% を指定しても、高さの基準となる
           親が定まらず反映されない（%指定の高さは、祖先を遡って定まった
           高さを持つ要素が必要なため）。 */
        #code-editor {
            flex: 1;
            min-height: 0;
            display: flex;
            flex-direction: column;
        }

        #code-editor-container:focus-within {
            border-color: #2563eb;
        }

        /* CodeMirrorエディタのスタイル調整 */
        .CodeMirror {
            height: 100% !important;
            font-family: 'Monaco', 'Menlo', 'Consolas', 'Liberation Mono', 'Courier New', monospace;
            font-size: var(--pp-code-font-size, 16px) !important;
            line-height: 1.5;
            border-radius: 6px;
            flex: 1;
            -webkit-text-size-adjust: 100%; /* Webkit系でのテキストサイズ調整を防ぐ */
        }

        .CodeMirror-scroll {
            min-height: 100% !important;
        }

        .CodeMirror-lines {
            padding: 4px 0;
        }

        .CodeMirror-focused .CodeMirror-cursor {
            border-left: 2px solid #2563eb;
        }

        /* 変数トレースでアクティブな実行行のハイライト */
        .CodeMirror .active-trace-line {
            background: rgba(37, 99, 235, 0.32) !important;
            box-shadow: inset 4px 0 0 #2563eb;
        }

        /* ステップを進めるたびに一瞬光らせて、たとえ同じ2行を往復していても
           「今、確かに1ステップ進んだ」ことが分かるようにする */
        @keyframes trace-step-pulse {
            0% { filter: brightness(2.2); }
            100% { filter: brightness(1); }
        }

        .CodeMirror .active-trace-line.trace-line-flash {
            animation: trace-step-pulse 0.5s ease-out;
        }

        /* 選択範囲の色を調整（より見やすく、透明度を下げる） */
        /* すべての可能な選択範囲セレクタをカバー */
        .CodeMirror .CodeMirror-selected,
        .CodeMirror.cm-s-material-darker .CodeMirror-selected,
        .cm-s-material-darker .CodeMirror-selected,
        div.CodeMirror-selected,
        .CodeMirror-selectedtext {
            background: rgba(128, 203, 196, 0.4) !important;
        }

        .CodeMirror-focused .CodeMirror-selected,
        .CodeMirror.cm-s-material-darker.CodeMirror-focused .CodeMirror-selected,
        .cm-s-material-darker.CodeMirror-focused .CodeMirror-selected {
            background: rgba(128, 203, 196, 0.5) !important;
        }

        /* ネイティブ選択もカバー */
        .CodeMirror pre.CodeMirror-line > span::selection,
        .CodeMirror pre.CodeMirror-line > span > span::selection,
        .CodeMirror-line::selection,
        .CodeMirror-line > span::selection,
        .CodeMirror-line > span > span::selection,
        .cm-s-material-darker .CodeMirror-line::selection,
        .cm-s-material-darker .CodeMirror-line > span::selection,
        .cm-s-material-darker .CodeMirror-line > span > span::selection {
            background: rgba(128, 203, 196, 0.4) !important;
        }

        /* フォールバックエディタのスタイル */
        #fallback-editor {
            width: 100%;
            height: 400px;
            padding: 15px;
            border: none;
            outline: none;
            font-family: 'Monaco', 'Menlo', 'Courier New', monospace;
            font-size: 16px; /* モバイルでズームを防ぐため16px以上に */
            line-height: 1.5;
            resize: vertical;
            -webkit-text-size-adjust: 100%; /* Webkit系でのテキストサイズ調整を防ぐ */
        }

        #output-area {
            height: 220px;
            flex-grow: 1;
            min-height: 0;
            padding: 15px;
            background: #1e293b;
            color: #e2e8f0;
            border-radius: 8px;
            font-family: 'Monaco', 'Menlo', 'Courier New', monospace;
            font-size: var(--pp-output-font-size, 14px);
            line-height: 1.5;
            overflow-y: auto;
            white-space: pre-wrap;
        }

        .output-line {
            margin-bottom: 4px;
        }

        .output-line.stderr {
            color: #ef4444;
        }

        .output-line.info {
            color: #10b981;
        }

        .loading, .ready, .running-msg {
            color: #64748b;
            font-style: italic;
            text-align: center;
            padding: 20px;
        }

        .running-msg {
            color: #3b82f6;
            animation: pulse 1.5s ease-in-out infinite;
        }

        @keyframes pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.5; }
        }

        .error {
            color: #ef4444;
            padding: 20px;
            text-align: center;
        }

        .btn {
            padding: 8px 12px;
            border: none;
            border-radius: 6px;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.3s;
            font-size: clamp(0.75rem, 1.8vw, 0.875rem);
            white-space: nowrap;
            min-width: fit-content;
        }

        .btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        .btn-primary {
            background: #2563eb;
            color: white;
        }

        .btn-primary:hover:not(:disabled) {
            background: #1d4ed8;
        }

        .btn-secondary {
            background: #64748b;
            color: white;
        }

        .btn-secondary:hover {
            background: #475569;
        }

        .btn-success {
            background: #22c55e;
            color: white;
        }

        .btn-success:hover {
            background: #16a34a;
        }

        .btn-info {
            background: #06b6d4;
            color: white;
        }

        .btn-info:hover {
            background: #0891b2;
        }

        .help-section {
            background: #f8fafc;
            padding: 20px;
            border-radius: 8px;
            border-left: 4px solid #10b981;
        }

        .help-section h3 {
            color: #1e293b;
            margin-bottom: 15px;
        }

        .help-section ul {
            list-style: none;
            padding: 0;
        }

        .help-section li {
            padding: 8px 0;
            border-bottom: 1px solid #e2e8f0;
        }

        .help-section li:last-child {
            border-bottom: none;
        }

        /* デバッグパネル（ループ実行カウンター・再帰トラッカー） */
        .debug-panels {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }

        .debug-panel {
            background: white;
            border: 2px solid #e2e8f0;
            border-radius: 8px;
            overflow: hidden;
        }

        .debug-header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 12px 15px;
        }

        .debug-header h3 {
            margin: 0;
            font-size: 1rem;
        }

        .debug-content {
            padding: 15px;
            min-height: 200px;
            max-height: 400px;
            overflow-y: auto;
            font-family: 'Monaco', 'Menlo', 'Courier New', monospace;
            font-size: 14px;
        }

        .debug-empty {
            color: #94a3b8;
            text-align: center;
            padding: 40px 20px;
            font-style: italic;
        }

        .loop-list {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .loop-group {
            margin-bottom: 20px;
            background: #fffbeb;
            padding: 15px;
            border-radius: 10px;
            border: 2px solid #f59e0b;
        }

        .loop-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 8px;
        }

        .loop-header-line {
            font-weight: 700;
            color: #92400e;
            font-size: 15px;
        }

        .loop-iteration-count {
            background: #f59e0b;
            color: white;
            padding: 4px 12px;
            border-radius: 12px;
            font-weight: 600;
            font-size: 13px;
        }

        .loop-header-code {
            background: white;
            padding: 8px 10px;
            border-radius: 6px;
            font-family: 'Monaco', 'Menlo', 'Courier New', monospace;
            font-size: 13px;
            color: #92400e;
            border: 1px solid #fde68a;
            margin-bottom: 12px;
            font-weight: 600;
        }

        .loop-item {
            background: #fef3c7;
            padding: 12px;
            border-radius: 8px;
            border-left: 4px solid #fbbf24;
            display: flex;
            flex-direction: column;
            gap: 8px;
            margin-bottom: 8px;
        }

        .loop-item:last-child {
            margin-bottom: 0;
        }

        .loop-info {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 10px;
        }

        .loop-line {
            font-weight: 600;
            color: #92400e;
            min-width: 50px;
        }

        .loop-iterations {
            color: #f59e0b;
            font-size: 14px;
            letter-spacing: 2px;
            flex: 1;
        }

        .loop-count {
            color: #b45309;
            font-weight: 600;
            background: white;
            padding: 4px 10px;
            border-radius: 4px;
            font-size: 13px;
            white-space: nowrap;
        }

        .loop-progress-bar {
            height: 6px;
            background: #fde68a;
            border-radius: 3px;
            overflow: hidden;
        }

        .loop-progress-fill {
            height: 100%;
            background: linear-gradient(90deg, #f59e0b 0%, #d97706 100%);
            transition: width 0.3s ease;
            border-radius: 3px;
        }

        .loop-code {
            background: white;
            padding: 8px 10px;
            border-radius: 4px;
            font-family: 'Monaco', 'Menlo', 'Courier New', monospace;
            font-size: 13px;
            color: #1e293b;
            border: 1px solid #fde68a;
            overflow-x: auto;
            white-space: pre;
            line-height: 1.4;
        }

        /* 再帰トラッカー */
        .recursion-list {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .recursion-item {
            background: #f0f9ff;
            padding: 12px;
            border-radius: 8px;
            border-left: 4px solid #3b82f6;
        }

        .recursion-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 8px;
            gap: 10px;
            flex-wrap: wrap;
        }

        .recursion-name {
            font-weight: 700;
            color: #1e40af;
            font-size: 15px;
        }

        .recursion-stats {
            display: flex;
            gap: 6px;
            flex-wrap: wrap;
        }

        .stat-badge {
            background: white;
            padding: 3px 8px;
            border-radius: 4px;
            font-size: 12px;
            color: #475569;
            font-weight: 500;
            border: 1px solid #dbeafe;
        }

        .stat-badge.depth {
            background: #dbeafe;
            color: #1e40af;
            font-weight: 600;
        }

        .recursion-depth-bar {
            background: #dbeafe;
            border-radius: 4px;
            padding: 6px 8px;
            overflow-x: auto;
        }

        .depth-fill {
            color: #3b82f6;
            font-weight: 700;
            font-family: monospace;
            letter-spacing: 1px;
            white-space: nowrap;
            font-size: 14px;
        }

        /* .output-section / .trace-section は常に縦方向のflexコンテナにしておき、
           .right-column（同じく縦方向のflex）の中で flex-grow:1 により余った縦幅を
           分け合う。コードエディタ側の内容（改行や折り返し）が増えて .code-section が
           縦に伸びると、CSS Gridの align-items:stretch で .right-column もそれに追従して
           伸びるため、この仕組みだけで「コードが伸びたら実行結果・変数トレースも伸びる」
           を実現できる（表示パネルが1つだけの時は、そのパネルが余った幅を全部受け取る）。
           #output-area / .trace-table-container 側は height（220px/360px）を
           flex-basisとして使いつつ flex-grow:1 を持たせ、それ以上の余白があれば
           埋める形にしている。height を明示指定したまま flex-grow するだけなので、
           内容量（実行結果の行数やトレースのステップ数）がどれだけ多くても、
           Grid/Flexの外側のサイズ計算に影響しない（内容に引っ張られて無制限に
           伸びる心配がない）。 */
        .output-section {
            display: flex;
            flex-direction: column;
            flex-grow: 1;
            min-width: 0;
            min-height: 0;
        }

        /* 変数トレース表示 */
        .trace-section {
            background: white;
            border: 2px solid #e2e8f0;
            border-radius: 8px;
            padding: 15px;
            display: flex;
            flex-direction: column;
            flex-grow: 1;
            min-width: 0;
            min-height: 0;
        }

        .orientation-toggle {
            display: flex;
            align-items: center;
            gap: 6px;
            cursor: pointer;
            font-size: 13px;
            color: #475569;
            user-select: none;
            white-space: nowrap;
        }

        .orientation-toggle input[type="checkbox"] {
            cursor: pointer;
            width: 16px;
            height: 16px;
        }

        .playback-controls {
            display: flex;
            align-items: center;
            gap: 8px;
            margin: 10px 0;
            flex-wrap: wrap;
        }

        .btn-play {
            background: #2563eb;
            color: white;
            border: none;
            border-radius: 6px;
            padding: 6px 10px;
            cursor: pointer;
            font-size: 16px;
            line-height: 1;
            transition: background 0.2s;
        }

        .btn-play:hover {
            background: #1d4ed8;
        }

        #trace-step-indicator {
            font-size: 14px;
            color: white;
            background: #2563eb;
            padding: 4px 12px;
            border-radius: 999px;
            margin-left: auto;
            white-space: nowrap;
            font-weight: 700;
            letter-spacing: 0.02em;
        }

        .trace-warning {
            background: #fef3c7;
            color: #92400e;
            border: 1px solid #fbbf24;
            border-radius: 6px;
            padding: 8px 12px;
            font-size: 13px;
            margin-bottom: 10px;
        }

        .trace-table-container {
            overflow: auto;
            /* max-height ではなく height で固定する。max-height だとステップ数や
               表の向きによって内容が短い時にコンテナ自体が縮んでしまい、行と列を
               入れ替えるたびにこのエリアの縦幅（≒ページ全体の高さ）が変わって
               しまう。常に同じ縦幅を保ち、その中でスクロールさせる。
               この height は flex-basis として使われ、.trace-section 内に
               余った縦幅があれば flex-grow:1 でそこまで広がる。 */
            height: 360px;
            flex-grow: 1;
            min-height: 0;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
        }

        .trace-table {
            border-collapse: collapse;
            width: max-content;
            min-width: 100%;
            font-size: var(--pp-trace-font-size, 14px);
            font-family: 'Monaco', 'Menlo', 'Courier New', monospace;
        }

        .trace-table th,
        .trace-table td {
            border: 1px solid #e2e8f0;
            padding: 6px 10px;
            text-align: center;
            white-space: nowrap;
        }

        .trace-table thead th {
            position: sticky;
            top: 0;
            background: #f8fafc;
            z-index: 2;
            cursor: pointer;
        }

        .trace-corner {
            position: sticky;
            left: 0;
            top: 0;
            z-index: 3;
            background: #f1f5f9 !important;
            text-align: left;
            width: 1%;
        }

        .trace-var-name,
        .trace-step-row-header {
            position: sticky;
            left: 0;
            background: #f8fafc;
            z-index: 1;
            font-weight: 600;
            color: #1e293b;
            text-align: left;
            /* min-width:100% で表全体を広げる際、列数が少ないと（特にstepsAsRowsの
               変数が1つだけの場合など）この見出し列にも余った幅が配分されて
               不必要に広くなってしまう。1% を指定することで、実質「内容に必要な
               分だけ」に縮めつつ、余った幅は隣のデータ列側に配分させる。 */
            width: 1%;
        }

        .trace-step-row-header {
            cursor: pointer;
        }

        .trace-step-header,
        .trace-var-header {
            color: #475569;
            font-weight: 600;
        }

        .trace-line-no {
            font-size: 1em;
            color: #94a3b8;
            font-weight: 400;
        }

        .trace-cell {
            cursor: pointer;
            color: #1e293b;
        }

        .trace-cell-empty {
            color: #cbd5e1;
        }

        .trace-cell-unchanged {
            color: #94a3b8;
        }

        .trace-cell-changed {
            background: rgba(37, 99, 235, 0.12);
            color: #1e3a8a;
            font-weight: 700;
        }

        .active-step {
            background: rgba(37, 99, 235, 0.22) !important;
            box-shadow: inset 0 0 0 2px #2563eb;
        }

        /* レスポンシブ対応 */
        @media (max-width: 768px) {
            .playground-content {
                grid-template-columns: 1fr;
            }

            .debug-panels {
                grid-template-columns: 1fr;
            }

            .section-header {
                flex-direction: column;
                align-items: flex-start;
                gap: 12px;
            }

            .section-header h3 {
                font-size: 1.1rem;
            }

            .controls {
                display: grid;
                grid-template-columns: repeat(auto-fit, minmax(70px, 1fr));
                gap: 6px;
                width: 100%;
            }

            .btn {
                padding: 10px 8px;
                font-size: 0.8rem;
            }

            /* モバイルでは左右が縦積みになる（.playground-content参照）ため、
               デスクトップ時の「右側と高さを揃える」flex:1をやめて固定高さに戻す。 */
            #code-editor-container {
                flex: none;
                height: 350px;
                min-height: 0;
            }

            .CodeMirror {
                height: 350px !important;
            }

            .CodeMirror-scroll {
                min-height: 350px !important;
            }

            #output-area {
                height: 200px;
            }

            .debug-content {
                max-height: 300px;
            }

            #trace-step-indicator {
                margin-left: 0;
            }

            .trace-table-container {
                height: 280px;
            }
        }

        @media (max-width: 480px) {
            .controls {
                grid-template-columns: repeat(2, 1fr);
            }

            .btn {
                padding: 12px 6px;
                font-size: 0.75rem;
            }
        }
    </style>
</Layout>
